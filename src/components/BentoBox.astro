---
interface ImageItem {
  src: string;
  alt: string;
  size?: 'small' | 'medium' | 'small_upper' | 'square' | 'large';
}

interface Props {
  images: ImageItem[];
}

const { images } = Astro.props;

// Map size prop to Tailwind classes for grid spanning
const sizeClasses = {
  small: 'col-span-1 row-span-1',
  medium: 'col-span-2 row-span-1',
  small_upper: 'col-span-1 row-span-2',
  square: 'col-span-2 row-span-2',
  large: 'col-span-3 row-span-2',
};
---


<div class="grid grid-cols-1 sm:grid-cols-4 gap-x-6 gap-y-1 aspect-square">
  {images.map((image) => (
    <div class={`rounded-md overflow-hidden ${sizeClasses[image.size || 'small']}`}>
      <img
        src={image.src}
        alt={image.alt}
        class="w-full h-full object-cover rounded-md"
      />
    </div>
  ))}
</div>