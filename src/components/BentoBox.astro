---
interface ImageItem {
  src: string
  /** Omit for decorative images — renders alt="" so screen readers skip them. */
  alt?: string
  size?: 'small' | 'medium' | 'small_upper' | 'square' | 'large'
}

interface Props {
  images: ImageItem[]
}

const { images } = Astro.props

// Row spans only mean anything once there's more than one column, so the
// square aspect ratio starts at the same breakpoint as the grid.
const sizeClasses = {
  small: 'sm:col-span-1 sm:row-span-1',
  medium: 'sm:col-span-2 sm:row-span-1',
  small_upper: 'sm:col-span-1 sm:row-span-2',
  square: 'sm:col-span-2 sm:row-span-2',
  large: 'sm:col-span-3 sm:row-span-2',
}
---

<div
  class="grid grid-cols-1 gap-x-6 gap-y-4 sm:aspect-square sm:grid-cols-4 sm:gap-y-1"
>
  {
    images.map((image) => (
      <div
        class={`overflow-hidden rounded-md ${sizeClasses[image.size || 'small']}`}
      >
        <img
          src={image.src}
          alt={image.alt ?? ''}
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] h-full w-full rounded-md object-cover sm:aspect-auto"
        />
      </div>
    ))
  }
</div>
