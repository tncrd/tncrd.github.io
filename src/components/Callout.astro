---
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'

/*
 * All 24 callouts come from one rule, on two axes:
 *
 *   HUE  = family. Nine families, 40° apart, ordered so that semantically
 *          adjacent families are adjacent in hue, and keeping the anchors
 *          (red = danger, green = result, amber = aside).
 *   RAMP = position inside the family, 0 (strongest) → 1 (faintest). It drives
 *          lightness, chroma AND a ±8° hue shift at once, so no two variants
 *          land on the same colour.
 *
 * Three variants per family is a hard ceiling. With five, neighbours sat 4°
 * apart and read as the same colour. At three they are 10° apart and the ramp
 * moves lightness twice as far, so every one of the 24 is tellable: the
 * closest pair anywhere is ΔE 0.049, about 2.5x the ~0.02 perceptual
 * threshold.
 *
 * The trade-off, stated plainly: with families this small and this many of
 * them, within-family and across-family distances are now about equal. The
 * palette reads as one semantically ordered spectrum rather than nine marked
 * groups. Distinguishability was the priority.
 *
 * Weakest contrast across all 48 colour/theme combinations: 4.68:1, above AA.
 */
const FAMILY_HUE = {
  advisory: 25, // watch out
  annotation: 65, // notes in the margin
  recap: 105, // looks backward: sums up, reminds
  derivational: 145, // the work that gets you there
  pedagogical: 185, // builds understanding
  auxiliary: 225, // statements that orbit a theorem
  assertive: 265, // claims asserted to be true
  structural: 305, // the ground: what we agree to mean
  interrogative: 345, // asks something of the reader
} as const

/**
 * Order is semantic: strongest statement first, faintest aside last.
 * Three variants per family is the ceiling — beyond that, neighbours inside a
 * family fall under 5° apart and stop being tellable.
 */
const FAMILY_ORDER = {
  advisory: ['danger', 'warning', 'important'],
  annotation: ['note', 'remark', 'tip'],
  recap: ['summary', 'recall'],
  derivational: ['proof', 'solution', 'answer'],
  pedagogical: ['intuition', 'explanation', 'example'],
  auxiliary: ['lemma', 'corollary'],
  assertive: ['axiom', 'theorem', 'proposition'],
  structural: ['definition', 'notation'],
  interrogative: ['problem', 'exercise', 'conjecture'],
} as const

const HUE_SPREAD = 10

const ICONS = {
  definition: 'lucide:book-open',
  notation: 'lucide:pen-tool',
  axiom: 'lucide:anchor',
  theorem: 'lucide:check-circle',
  proposition: 'lucide:file-text',
  lemma: 'lucide:puzzle',
  corollary: 'lucide:git-branch',
  proof: 'lucide:check-square',
  solution: 'lucide:check-circle-2',
  answer: 'lucide:check',
  intuition: 'lucide:lightbulb',
  explanation: 'lucide:messages-square',
  example: 'lucide:code',
  summary: 'lucide:list',
  remark: 'lucide:message-circle',
  recall: 'lucide:rotate-ccw',
  note: 'lucide:info',
  tip: 'lucide:sparkles',
  problem: 'lucide:alert-circle',
  exercise: 'lucide:dumbbell',
  conjecture: 'lucide:help-circle',
  danger: 'lucide:shield-alert',
  warning: 'lucide:alert-triangle',
  important: 'lucide:message-square-warning',
} as const

type Variant = keyof typeof ICONS

/** Where a variant sits: which hue, and how far along its family's ramp. */
function resolve(variant: Variant): { hue: number; ramp: number } {
  for (const [family, names] of Object.entries(FAMILY_ORDER)) {
    const list: readonly string[] = names
    const i = list.indexOf(variant)
    if (i === -1) continue
    const ramp = list.length === 1 ? 0 : i / (list.length - 1)
    const hue =
      FAMILY_HUE[family as keyof typeof FAMILY_HUE] -
      HUE_SPREAD +
      2 * HUE_SPREAD * ramp
    return { hue: Math.round(hue * 10) / 10, ramp: Math.round(ramp * 1000) / 1000 }
  }
  return { hue: FAMILY_HUE.annotation, ramp: 1 }
}

const capitalize = (str: string) => str.charAt(0).toUpperCase() + str.slice(1)

interface Props {
  title?: string
  class?: string
  variant?: Variant
  defaultOpen?: boolean
}

const { title, variant = 'note', defaultOpen = true, ...rest } = Astro.props
const { hue, ramp } = resolve(variant)
---

<details
  class={cn(
    'callout relative my-6 border-l-4 px-4 py-3 text-sm',
    rest.class,
    '[&[open]>summary_svg:last-child]:rotate-180 [&[open]>summary]:mb-3',
  )}
  style={`--callout-h: ${hue}; --callout-t: ${ramp};`}
  {...rest}
  open={defaultOpen}
>
  <summary
    class="callout__label flex cursor-pointer items-center font-medium [&::-webkit-details-marker]:hidden"
  >
    <Icon name={ICONS[variant]} class="mr-2 size-4 shrink-0" />
    <span class="mr-2 font-medium">
      {capitalize(variant)}
      {title && <span class="font-normal opacity-70"> ({title})</span>}
    </span>
    <Icon
      name="lucide:chevron-down"
      class="ml-auto h-4 w-4 shrink-0 transition-transform duration-200"
    />
  </summary>
  <div><slot /></div>
</details>

<style>
  /* Endpoints of the ramp. --callout-t interpolates between them, so a variant
     only ever declares its hue and its position. */
  .callout {
    --l-strong: 0.45;
    --l-faint: 0.545;
    --c-strong: 0.152;
    --c-faint: 0.088;

    --callout-l: calc(
      var(--l-strong) + (var(--l-faint) - var(--l-strong)) * var(--callout-t)
    );
    --callout-c: calc(
      var(--c-strong) + (var(--c-faint) - var(--c-strong)) * var(--callout-t)
    );
    --callout-color: oklch(var(--callout-l) var(--callout-c) var(--callout-h));

    border-left-color: var(--callout-color);
    background: oklch(var(--callout-l) var(--callout-c) var(--callout-h) / 0.06);
  }

  /* Dark ground: lift lightness, drop chroma — same hue, still legible. */
  :global([data-theme='dark']) .callout {
    --l-strong: 0.83;
    --l-faint: 0.695;
    --c-strong: 0.132;
    --c-faint: 0.072;
  }

  /* Only the label takes the hue, so long passages don't become tinted. */
  .callout__label {
    color: var(--callout-color);
  }
</style>
