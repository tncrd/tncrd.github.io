---
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { cva, type VariantProps } from 'class-variance-authority'

/*
 * Colour encodes the FAMILY — what kind of thing this is.
 * The icon distinguishes variants WITHIN a family.
 *
 * This is why `theorem`, `lemma` and `corollary` share a hue: they are the same
 * category of statement, and that is true information about the content. A hue
 * per variant made colour decorative — you could not tell a theorem from an
 * answer, so the colour stopped meaning anything.
 */
const families = {
  structural: {
    style: 'border-violet-500 bg-violet-500/5',
    textColor: 'text-violet-700 dark:text-violet-300',
  },
  assertive: {
    style: 'border-teal-600 bg-teal-600/5',
    textColor: 'text-teal-700 dark:text-teal-300',
  },
  derivational: {
    style: 'border-emerald-600 bg-emerald-600/5',
    textColor: 'text-emerald-700 dark:text-emerald-300',
  },
  pedagogical: {
    style: 'border-sky-500 bg-sky-500/5',
    textColor: 'text-sky-700 dark:text-sky-300',
  },
  interrogative: {
    style: 'border-fuchsia-500 bg-fuchsia-500/5',
    textColor: 'text-fuchsia-700 dark:text-fuchsia-300',
  },
  advisory: {
    style: 'border-amber-500 bg-amber-500/5',
    textColor: 'text-amber-700 dark:text-amber-300',
  },
  // `danger` is the one exception to one-hue-per-family: red for danger is too
  // strong a convention to trade away for consistency.
  critical: {
    style: 'border-red-500 bg-red-500/5',
    textColor: 'text-red-700 dark:text-red-300',
  },
} as const

const calloutConfig = {
  // — structural: names the objects we reason about
  definition: { family: 'structural', icon: 'lucide:book-open' },
  notation: { family: 'structural', icon: 'lucide:pen-tool' },

  // — assertive: claims asserted to be true
  theorem: { family: 'assertive', icon: 'lucide:check-circle' },
  lemma: { family: 'assertive', icon: 'lucide:puzzle' },
  proposition: { family: 'assertive', icon: 'lucide:file-text' },
  corollary: { family: 'assertive', icon: 'lucide:git-branch' },
  axiom: { family: 'assertive', icon: 'lucide:anchor' },

  // — derivational: the work that gets you there
  proof: { family: 'derivational', icon: 'lucide:check-square' },
  solution: { family: 'derivational', icon: 'lucide:check-circle-2' },
  answer: { family: 'derivational', icon: 'lucide:check' },

  // — pedagogical: helps the reader hold on to it
  intuition: { family: 'pedagogical', icon: 'lucide:lightbulb' },
  explanation: { family: 'pedagogical', icon: 'lucide:messages-square' },
  example: { family: 'pedagogical', icon: 'lucide:code' },
  recall: { family: 'pedagogical', icon: 'lucide:rotate-ccw' },
  remark: { family: 'pedagogical', icon: 'lucide:message-circle' },
  note: { family: 'pedagogical', icon: 'lucide:info' },
  tip: { family: 'pedagogical', icon: 'lucide:sparkles' },
  summary: { family: 'pedagogical', icon: 'lucide:list' },

  // — interrogative: asks something of the reader
  exercise: { family: 'interrogative', icon: 'lucide:dumbbell' },
  problem: { family: 'interrogative', icon: 'lucide:alert-circle' },
  conjecture: { family: 'interrogative', icon: 'lucide:help-circle' },

  // — advisory: watch out
  important: { family: 'advisory', icon: 'lucide:message-square-warning' },
  warning: { family: 'advisory', icon: 'lucide:alert-triangle' },
  danger: { family: 'critical', icon: 'lucide:shield-alert' },
} as const

const capitalize = (str: string) => str.charAt(0).toUpperCase() + str.slice(1)

const styleFor = (v: keyof typeof calloutConfig) =>
  families[calloutConfig[v].family].style
const textFor = (v: keyof typeof calloutConfig) =>
  families[calloutConfig[v].family].textColor

const calloutVariants = cva('relative px-4 py-3 my-6 border-l-4 text-sm', {
  variants: {
    variant: Object.fromEntries(
      Object.keys(calloutConfig).map((key) => [
        key,
        styleFor(key as keyof typeof calloutConfig),
      ]),
    ),
  },
  defaultVariants: {
    variant: 'note',
  },
})

interface Props extends VariantProps<typeof calloutVariants> {
  title?: string
  class?: string
  variant?: keyof typeof calloutConfig
  defaultOpen?: boolean
}

const { title, variant = 'note', defaultOpen = true, ...rest } = Astro.props
const accent = textFor(variant)
---

<details
  class={cn(
    calloutVariants({ variant }),
    rest.class,
    '[&[open]>summary_svg:last-child]:rotate-180 [&[open]>summary]:mb-3',
  )}
  {...rest}
  open={defaultOpen}
>
  <summary
    class="flex cursor-pointer items-center font-medium [&::-webkit-details-marker]:hidden"
  >
    <Icon
      name={calloutConfig[variant].icon}
      class={cn('mr-2 size-4 shrink-0', accent)}
    />
    <span class={cn('mr-2 font-medium', accent)}>
      {capitalize(variant)}
      {title && <span class="font-normal opacity-70"> ({title})</span>}
    </span>
    <Icon
      name="lucide:chevron-down"
      class={cn(
        'ml-auto h-4 w-4 shrink-0 transition-transform duration-200',
        accent,
      )}
    />
  </summary>
  <div>
    <slot />
  </div>
</details>
