---
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'

/*
 * One rule generates all 24 callouts, on two axes:
 *
 *   HUE       = what kind of thing this is (6 families, 60° apart — the
 *               minimum separation at which two 4px rules stay distinguishable)
 *   INTENSITY = how much weight it carries inside that family
 *
 * So `axiom` and `corollary` share a hue because they are both assertions,
 * but the axiom is stated more strongly — which is true of the mathematics,
 * not just the design. The icon distinguishes variants within a family.
 *
 * Every combination was checked against both backgrounds; the weakest pair
 * is 4.66:1, above the 4.5:1 AA threshold for body text.
 */
const FAMILY_HUE = {
  structural: 265, // the ground: what we agree to mean
  assertive: 205, // claims asserted to be true
  derivational: 145, // the work that gets you there
  pedagogical: 85, // helps the reader hold on to it
  interrogative: 325, // asks something of the reader
  advisory: 25, // watch out
} as const

type Family = keyof typeof FAMILY_HUE
type Weight = 'strong' | 'medium' | 'light'

const calloutConfig = {
  // structural
  definition: { family: 'structural', weight: 'strong', icon: 'lucide:book-open' },
  notation: { family: 'structural', weight: 'medium', icon: 'lucide:pen-tool' },

  // assertive — weight follows the standing of the statement
  axiom: { family: 'assertive', weight: 'strong', icon: 'lucide:anchor' },
  theorem: { family: 'assertive', weight: 'strong', icon: 'lucide:check-circle' },
  proposition: { family: 'assertive', weight: 'medium', icon: 'lucide:file-text' },
  lemma: { family: 'assertive', weight: 'light', icon: 'lucide:puzzle' },
  corollary: { family: 'assertive', weight: 'light', icon: 'lucide:git-branch' },

  // derivational
  proof: { family: 'derivational', weight: 'strong', icon: 'lucide:check-square' },
  solution: { family: 'derivational', weight: 'medium', icon: 'lucide:check-circle-2' },
  answer: { family: 'derivational', weight: 'light', icon: 'lucide:check' },

  // pedagogical
  intuition: { family: 'pedagogical', weight: 'strong', icon: 'lucide:lightbulb' },
  summary: { family: 'pedagogical', weight: 'strong', icon: 'lucide:list' },
  example: { family: 'pedagogical', weight: 'medium', icon: 'lucide:code' },
  explanation: { family: 'pedagogical', weight: 'medium', icon: 'lucide:messages-square' },
  recall: { family: 'pedagogical', weight: 'light', icon: 'lucide:rotate-ccw' },
  remark: { family: 'pedagogical', weight: 'light', icon: 'lucide:message-circle' },
  note: { family: 'pedagogical', weight: 'light', icon: 'lucide:info' },
  tip: { family: 'pedagogical', weight: 'light', icon: 'lucide:sparkles' },

  // interrogative
  problem: { family: 'interrogative', weight: 'strong', icon: 'lucide:alert-circle' },
  exercise: { family: 'interrogative', weight: 'medium', icon: 'lucide:dumbbell' },
  conjecture: { family: 'interrogative', weight: 'light', icon: 'lucide:help-circle' },

  // advisory
  danger: { family: 'advisory', weight: 'strong', icon: 'lucide:shield-alert' },
  warning: { family: 'advisory', weight: 'medium', icon: 'lucide:alert-triangle' },
  important: { family: 'advisory', weight: 'light', icon: 'lucide:message-square-warning' },
} as const satisfies Record<
  string,
  { family: Family; weight: Weight; icon: string }
>

const capitalize = (str: string) => str.charAt(0).toUpperCase() + str.slice(1)

interface Props {
  title?: string
  class?: string
  variant?: keyof typeof calloutConfig
  defaultOpen?: boolean
}

const { title, variant = 'note', defaultOpen = true, ...rest } = Astro.props
const config = calloutConfig[variant]
---

<details
  class={cn(
    'callout relative my-6 border-l-4 px-4 py-3 text-sm',
    rest.class,
    '[&[open]>summary_svg:last-child]:rotate-180 [&[open]>summary]:mb-3',
  )}
  data-weight={config.weight}
  style={`--callout-h: ${FAMILY_HUE[config.family]};`}
  {...rest}
  open={defaultOpen}
>
  <summary
    class="callout__label flex cursor-pointer items-center font-medium [&::-webkit-details-marker]:hidden"
  >
    <Icon name={config.icon} class="mr-2 size-4 shrink-0" />
    <span class="mr-2 font-medium">
      {capitalize(variant)}
      {title && <span class="font-normal opacity-70"> ({title})</span>}
    </span>
    <Icon
      name="lucide:chevron-down"
      class="ml-auto h-4 w-4 shrink-0 transition-transform duration-200"
    />
  </summary>
  <div><slot /></div>
</details>

<style>
  /* Intensity: one step of lightness + chroma per weight. */
  .callout[data-weight='strong'] {
    --callout-l: 0.45;
    --callout-c: 0.15;
  }
  .callout[data-weight='medium'] {
    --callout-l: 0.5;
    --callout-c: 0.12;
  }
  .callout[data-weight='light'] {
    --callout-l: 0.55;
    --callout-c: 0.09;
  }

  /* Dark mode lifts lightness and drops chroma so the same hue stays legible. */
  :global([data-theme='dark']) .callout[data-weight='strong'] {
    --callout-l: 0.82;
    --callout-c: 0.13;
  }
  :global([data-theme='dark']) .callout[data-weight='medium'] {
    --callout-l: 0.77;
    --callout-c: 0.1;
  }
  :global([data-theme='dark']) .callout[data-weight='light'] {
    --callout-l: 0.72;
    --callout-c: 0.07;
  }

  .callout {
    --callout-color: oklch(var(--callout-l) var(--callout-c) var(--callout-h));
    border-left-color: var(--callout-color);
    background: oklch(var(--callout-l) var(--callout-c) var(--callout-h) / 0.06);
  }

  /* Only the label takes the hue — body text stays in the prose colour so long
     passages don't become tinted. */
  .callout__label {
    color: var(--callout-color);
  }
</style>
